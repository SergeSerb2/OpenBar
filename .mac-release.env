MAC_RELEASE_APP_NAME=OpenBar
MAC_RELEASE_REPO=SergeSerb2/OpenBar
MAC_RELEASE_BUNDLE_ID=com.serbinenko.openbar
MAC_RELEASE_VERSION_FILE=version.env
MAC_RELEASE_APPCAST=appcast.xml
MAC_RELEASE_SOURCE_FILES='Scripts/release_artifacts.sh'
MAC_RELEASE_SUPUBLIC_ED_KEY=AGCY8w5vHirVfGGDGc8Szc5iuOqupZSh9pMj/Qs67XI=

MAC_RELEASE_APP_ZIP='$(openbar_app_zip_name "$MARKETING_VERSION" "${ARCHES:-arm64 x86_64}")'
MAC_RELEASE_DSYM_ZIP='$(openbar_dsym_zip_name "$MARKETING_VERSION" "${ARCHES:-arm64 x86_64}")'
MAC_RELEASE_ARTIFACT_PREFIX='OpenBar-macos-[A-Za-z0-9_+-]+-'
MAC_RELEASE_FEED_URL='https://raw.githubusercontent.com/SergeSerb2/OpenBar/main/appcast.xml'
MAC_RELEASE_DOWNLOAD_URL_PREFIX='https://github.com/SergeSerb2/OpenBar/releases/download/v${MARKETING_VERSION}/'

MAC_RELEASE_GENERATE_APPCAST_ARGS='--maximum-deltas 0'
MAC_RELEASE_EXTRA_ASSET_WAIT_SECONDS=3600
MAC_RELEASE_EXTRA_ASSET_WAIT_INTERVAL=30
MAC_RELEASE_EXTRA_ASSET_PATTERNS='^OpenBarCLI-v${MARKETING_VERSION}-macos-arm64\.tar\.gz$
^OpenBarCLI-v${MARKETING_VERSION}-macos-arm64\.tar\.gz\.sha256$
^OpenBarCLI-v${MARKETING_VERSION}-macos-x86_64\.tar\.gz$
^OpenBarCLI-v${MARKETING_VERSION}-macos-x86_64\.tar\.gz\.sha256$
^OpenBarCLI-v${MARKETING_VERSION}-linux-aarch64\.tar\.gz$
^OpenBarCLI-v${MARKETING_VERSION}-linux-aarch64\.tar\.gz\.sha256$
^OpenBarCLI-v${MARKETING_VERSION}-linux-x86_64\.tar\.gz$
^OpenBarCLI-v${MARKETING_VERSION}-linux-x86_64\.tar\.gz\.sha256$
^OpenBarCLI-v${MARKETING_VERSION}-linux-musl-aarch64\.tar\.gz$
^OpenBarCLI-v${MARKETING_VERSION}-linux-musl-aarch64\.tar\.gz\.sha256$
^OpenBarCLI-v${MARKETING_VERSION}-linux-musl-x86_64\.tar\.gz$
^OpenBarCLI-v${MARKETING_VERSION}-linux-musl-x86_64\.tar\.gz\.sha256$
^OpenBarDesktop-v${MARKETING_VERSION}-linux-x86_64\.tar\.gz$
^OpenBarDesktop-v${MARKETING_VERSION}-linux-x86_64\.tar\.gz\.sha256$
^OpenBarDesktop-v${MARKETING_VERSION}-linux-aarch64\.tar\.gz$
^OpenBarDesktop-v${MARKETING_VERSION}-linux-aarch64\.tar\.gz\.sha256$'
